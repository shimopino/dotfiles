// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Agent Panel の活用はしたいが、コードの補完は出さないようにする
  "show_completions_on_input": true, // LSP 補完の自動表示
  "show_edit_predictions": false, // AI による inline 予測補完を非表示にする
  "disable_ai": false, // Agent など他の AI 機能はそのまま使える

  // ファイル保存時にフォーマットを適用する
  "format_on_save": "on",
  "formatter": "auto",

  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    // "default_model": {
    //   "provider": "llama.cpp",
    //   "model": "kat-coder-v2.5-dev",
    //   "enable_thinking": true,
    // },
    "default_model": {
      "provider": "omlx",
      "model": "Qwen3.6-35B-A3B-oQ4e-mtp",
      "enable_thinking": false,
    },
    "dock": "right",
    "sidebar_side": "right",
    "tool_permissions": {
      "default": "allow",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "thought_level": "minimal",
        "model": "openai-codex/gpt-6-astra"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "model": "opencode-go/mimo-v2.6-pro",
      },
      "favorite_config_option_values": {
        "model": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/grok-4.5",
          "opencode-go/gpt-5.6-luna",
          "opencode-go/qwen3.8-max",
          "opencode-go/glm-5.3",
          "opencode-go/hy4-preview",
          "opencode-go/qwen3.8-flash",
          "opencode-go/deepseek-v4.1-flash",
          "opencode-go/muse-spark-1.3-contributor",
          "opencode-go/glm-5.3-flash"
        ],
      },
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": false,
        "reasoning_effort": "high",
        "model": "gpt-5.6-sol",
      },
      "favorite_config_option_values": {
        "mode": ["auto"],
      },
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "model": "fable",
        "mode": "auto",
        "effort": "high",
      },
      "favorite_config_option_values": {
        "model": ["default"],
      },
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayVariableTypeHints": true,
        },
      },
    },
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },
  "hover_popover_enabled": true,
  "preview_tabs": {
    "enabled": false,
  },

  // v1.9 から導入された テキスト検索ピッカー
  "file_finder": {
    "modal_max_width": "xlarge",
    "file_icons": true,
    "skip_focus_for_active_in_search": true,
  },

  // herdr
  "terminal": {
    // "shell": {
    //   "with_arguments": {
    //     "program": "/bin/zsh",
    //     "args": ["-l", "-c", "eval \"$(mise activate zsh)\" && herdr"],
    //   },
    // },
    "font_family": "Hack Nerd Font Mono",
    "font_size": 16,
  },

  "language_models": {
    "llama.cpp": {
      "api_url": "http://localhost:8080",
    },
    "openai_compatible": {
      "omlx": {
        "api_url": "http://127.0.0.1:8080/v1",
        "available_models": [
          {
            "name": "Qwen3.6-35B-A3B-oQ4e-mtp",
            "display_name": "Qwen3.6 35B-A3B / oMLX",
            "max_tokens": 65536,
            "max_output_tokens": 8192,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
}
